# Exemplo de variáveis de ambiente para o docker-compose local.
# Copie este arquivo para `.env` e ajuste os valores; nunca committe `.env`.

# -------------------------------------------------------------------------
# Infraestrutura (usado por docker-compose.all.yml)
# -------------------------------------------------------------------------
MSSQL_SA_PASSWORD=<YOUR_STRONG_PASSWORD>

# -------------------------------------------------------------------------
# API (usado por docker-compose.yml e docker-compose.all.yml)
# -------------------------------------------------------------------------
CONNECTIONSTRINGS_DEFAULT=Server=eaf-sqlserver,1433;Database=afonsoft_eaf;user id=sa;Password=<YOUR_STRONG_PASSWORD>;TrustServerCertificate=True;Encrypt=false
DATABASE_PROVIDER=SqlServer
HANGFIRE_ENABLED=false
SQLSERVERCACHE_ENABLED=false
REDISCACHE_ENABLED=false

ASPNETCORE_ENVIRONMENT=Staging
DOTNET_ENVIRONMENT=Staging

APP_SERVER_ROOT_ADDRESS=http://localhost:5000/
APP_CLIENT_ROOT_ADDRESS=http://localhost:4200/
APP_CORS_ORIGINS=http://localhost:4200

EAF_API_CONTAINER_NAME=eaf-api
EAF_API_PORT=5000

# -------------------------------------------------------------------------
# Angular (usado por docker-compose.yml e docker-compose.all.yml)
# -------------------------------------------------------------------------
REMOTE_SERVICE_BASE_URL=http://localhost:5000
APP_BASE_URL=http://localhost:4200
EAF_ANGULAR_CONTAINER_NAME=eaf-angular
EAF_ANGULAR_PORT=4200
