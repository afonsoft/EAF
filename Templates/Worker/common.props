<Project>

	<PropertyGroup>
		<Version>7.0.0</Version>
		<TemplateVersion>7.0.0.0</TemplateVersion>
		<PackageProjectUrl>http://www.projectname.com.br/</PackageProjectUrl>
		<PackageLicenseUrl>https://https://github.com/afonsoft/projectname/</PackageLicenseUrl>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://https://github.com/afonsoft/projectname/</RepositoryUrl>
		<Authors>AFONSOFT</Authors>
		<Company>EAF</Company>
		<Copyright>Copyright © 2024</Copyright>
		<LangVersion>10.0</LangVersion>
		<PreserveCompilationContext>true</PreserveCompilationContext>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
		<Platform>Any CPU</Platform>
		<SelfContained>false</SelfContained>
		<NoWarn>$(NoWarn);CS1591;SYSLIB0001;SYSLIB0002;SYSLIB0003;MSB3277;NU1903</NoWarn>
		<MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3253;MSB3277</MSBuildWarningsAsMessages>
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
		<ServerGarbageCollection>true</ServerGarbageCollection>
		<GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
		<UseWindowsThreadPool>true</UseWindowsThreadPool>
		<PublishAot>false</PublishAot>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
	</PropertyGroup>
	<!-- Suppress AutoMapper 14.0.0 vulnerability (GHSA-rvv3-g6hj-g44x) - no patched free 14.x exists; Abp.AutoMapper 10.4.0 is binary-incompatible with AutoMapper >= 15.0.0. -->
	<ItemGroup>
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
	</ItemGroup>
</Project>