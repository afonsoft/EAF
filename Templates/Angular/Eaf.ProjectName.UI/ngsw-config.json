{
  "assetGroups": [
      {
          "installMode": "prefetch",
          "updateMode": "prefetch",
          "name": "app",
          "resources": {
            "files": [
              "/favicon.ico",
              "/index.html",
              "/manifest.json",
              "/*.bundle.css",
              "/*.bundle.js",
              "/*.chunk.js"
            ]
          }
        },
        {
          "installMode": "lazy",
          "updateMode": "prefetch",
          "name": "assets",
          "resources": {
            "files": [
              "/assets/**",
              "/*.(eot|svg|cur|jpg|png|webp|gif|otf|ttf|woff|woff2|ani)"
            ]
          }
        }
  ],
  "dataGroups": [
    {
      "cacheConfig": {
        "maxAge": "1d",
        "maxSize": 256,
        "timeout": "30s",
        "strategy": "performance"
      },
      "name": "api-read",
      "urls": [
        "/api/AbpUserConfiguration/GetAll",
        "/api/services/app/**/Get*",
        "/api/services/app/**/GetAll*"
      ]
    },
    {
      "cacheConfig": {
        "maxAge": "0u",
        "maxSize": 0,
        "timeout": "30s",
        "strategy": "freshness"
      },
      "name": "api-write",
      "urls": [
        "/api/AbpUserConfiguration/GetAll",
        "/api/services/app/**/Create*",
        "/api/services/app/**/Update*",
        "/api/services/app/**/Delete*"
      ]
    }
  ],
  "index": "/index.html"
}