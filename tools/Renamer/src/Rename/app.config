				<value>.cs,.cshtml,.js,.ts,.csproj,.sln,.xml,.config,.DotSettings,.json,.xaml,.txt,.html,.gitignore,.ps1,.md,.plist,.tpl</value>
			</setting>
			<setting name="setOldCompanyName" serializeAs="String">
