			</setting>
			<setting name="setNewProjectName" serializeAs="String">
				<value>eaf-ProjectName-ui</value>
			</setting>
			<setting name="setOldAreaName" serializeAs="String">
				<value>AppAreaName</value>
			</setting>
			<setting name="setNewAreaName" serializeAs="String">
				<value>App</value>
			</setting>
		</EAFRenamer.Properties.Settings>
	</userSettings>
