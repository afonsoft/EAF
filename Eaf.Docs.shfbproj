      <DocumentationSource sourceFile="src\Eaf.AspNetCore\Eaf.AspNetCore.csproj" />
      <DocumentationSource sourceFile="src\Eaf.AutoMapper\Eaf.AutoMapper.csproj" />
      <DocumentationSource sourceFile="src\Eaf.Castle.Log4Net\Eaf.Castle.Log4Net.csproj" />
      <DocumentationSource sourceFile="src\Eaf.Castle.Serilog\Eaf.Castle.Serilog.csproj" />
      <DocumentationSource sourceFile="src\Eaf.Dapper\Eaf.Dapper.csproj" />
      <DocumentationSource sourceFile="src\Eaf.EntityFramework.Common\Eaf.EntityFramework.Common.csproj" />
      <DocumentationSource sourceFile="src\Eaf.EntityFrameworkCore.EFPlus\Eaf.EntityFrameworkCore.EFPlus.csproj" />
      <DocumentationSource sourceFile="src\Eaf.EntityFrameworkCore\Eaf.EntityFrameworkCore.csproj" />
      <DocumentationSource sourceFile="src\Eaf.FluentValidation\Eaf.FluentValidation.csproj" />
      <DocumentationSource sourceFile="src\Eaf.HangFire.AspNetCore\Eaf.HangFire.AspNetCore.csproj" />
      <DocumentationSource sourceFile="src\Eaf.KeyVault.AspNetCore\Eaf.KeyVault.AspNetCore.csproj" />
      <DocumentationSource sourceFile="src\Eaf.KeyVault\Eaf.KeyVault.csproj" />
      <DocumentationSource sourceFile="src\Eaf.Log4NetServiceBus\Eaf.Log4NetServiceBus.csproj" />
      <DocumentationSource sourceFile="src\Eaf.MailKit\Eaf.MailKit.csproj" />
      <DocumentationSource sourceFile="src\Eaf.MemoryDb\Eaf.MemoryDb.csproj" />
      <DocumentationSource sourceFile="src\Eaf.Middleware.Application\Eaf.Middleware.Application.csproj" />
      <DocumentationSource sourceFile="src\Eaf.Middleware.AzureActiveDirectory\Eaf.Middleware.AzureActiveDirectory.csproj" />
      <DocumentationSource sourceFile="src\Eaf.Middleware.Common\Eaf.Middleware.Common.csproj" />
      <DocumentationSource sourceFile="src\Eaf.Middleware.Core\Eaf.Middleware.Core.csproj" />
      <DocumentationSource sourceFile="src\Eaf.Middleware.Ldap\Eaf.Middleware.Ldap.csproj" />
      <DocumentationSource sourceFile="src\Eaf.Middleware.Web.Core\Eaf.Middleware.Web.Core.csproj" />
      <DocumentationSource sourceFile="src\Eaf.Middleware.Worker\Eaf.Middleware.Worker.csproj" />
      <DocumentationSource sourceFile="src\Eaf.MiddlewareCore.EntityFrameworkCore\Eaf.MiddlewareCore.EntityFrameworkCore.csproj" />
      <DocumentationSource sourceFile="src\Eaf.MiddlewareCore\Eaf.MiddlewareCore.csproj" />
      <DocumentationSource sourceFile="src\Eaf.OpenTelemetry\Eaf.OpenTelemetry.csproj" />
      <DocumentationSource sourceFile="src\Eaf.OracleCache\Eaf.OracleCache.csproj" />
      <DocumentationSource sourceFile="src\Eaf.Polly\Eaf.Polly.csproj" />
      <DocumentationSource sourceFile="src\Eaf.RedisCache.ProtoBuf\Eaf.RedisCache.ProtoBuf.csproj" />
      <DocumentationSource sourceFile="src\Eaf.RedisCache\Eaf.RedisCache.csproj" />
      <DocumentationSource sourceFile="src\Eaf.SqliteCache\Eaf.SqliteCache.csproj" />
      <DocumentationSource sourceFile="src\Eaf.TestBase\Eaf.TestBase.csproj" />
      <DocumentationSource sourceFile="src\Eaf.TextTemplating\Eaf.TextTemplating.csproj" />
      <DocumentationSource sourceFile="src\Eaf.Web.Common\Eaf.Web.Common.csproj" />
    </DocumentationSources>
    <CleanIntermediates>True</CleanIntermediates>
    <KeepLogFile>False</KeepLogFile>
    <DisableCodeBlockComponent>False</DisableCodeBlockComponent>
    <IndentHtml>False</IndentHtml>
    <BuildAssemblerVerbosity>OnlyWarningsAndErrors</BuildAssemblerVerbosity>
    <SaveComponentCacheCapacity>200</SaveComponentCacheCapacity>
    <HtmlSdkLinkType>Msdn</HtmlSdkLinkType>
    <BinaryTOC>True</BinaryTOC>
    <IncludeFavorites>True</IncludeFavorites>
    <WebsiteSdkLinkType>Msdn</WebsiteSdkLinkType>
    <AppendMarkdownFileExtensionsToUrls>True</AppendMarkdownFileExtensionsToUrls>
    <CatalogProductId>VS</CatalogProductId>
    <CatalogVersion>100</CatalogVersion>
    <VendorName>Eaf</VendorName>
    <ProductTitle>Eaf.Help</ProductTitle>
    <TocOrder>-1</TocOrder>
    <TocParentId>-1</TocParentId>
    <TocParentVersion>100</TocParentVersion>
    <TopicVersion>100</TopicVersion>
    <MSHelpViewerSdkLinkType>Msdn</MSHelpViewerSdkLinkType>
    <PlugInConfigurations>
      <PlugInConfig id="Assembly Binding Redirection" enabled="True">
        <configuration useGAC="true">
          <assemblyBinding />
          <ignoreIfUnresolved>
            <assemblyIdentity name="BusinessObjects.Licensing.KeycodeDecoder" />
            <assemblyIdentity name="Microsoft.VisualStudio.TestTools.UITest.Playback" />
            <assemblyIdentity name="Z.EntityFramework.Extensions.EFCore" />
            <assemblyIdentity name="Microsoft.AspNetCore.OData" />
            <assemblyIdentity name="Microsoft.AspNetCore.TestHost" />
            <assemblyIdentity name="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
            <assemblyIdentity name="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" />
            <assemblyIdentity name="Owl.reCAPTCHA" />
          </ignoreIfUnresolved>
        </configuration>
      </PlugInConfig>
    </PlugInConfigurations>
    <HelpTitle>Eaf Help</HelpTitle>
    <HelpFileVersion>1.0.0.0</HelpFileVersion>
    <NamingMethod>MemberName</NamingMethod>
    <ContentPlacement>AboveNamespaces</ContentPlacement>
    <RootNamespaceContainer>True</RootNamespaceContainer>
    <NamespaceGrouping>False</NamespaceGrouping>
    <MaximumGroupParts>2</MaximumGroupParts>
    <Preliminary>False</Preliminary>
    <SdkLinkTarget>Blank</SdkLinkTarget>
  </PropertyGroup>
  <!-- There are no properties for these groups.  AnyCPU needs to appear in order for Visual Studio to perform
			 the build.  The others are optional common platform types that may appear. -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|Win32' ">
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|Win32' ">
  </PropertyGroup>
  <!-- Import the common build targets during NuGet restore because before the packages are being installed, $(SHFBROOT) is not set yet -->
  <Import Project="$(MSBuildToolsPath)\Microsoft.Common.targets" Condition="'$(MSBuildRestoreSessionId)' != ''" />
  <!-- Import the SHFB build targets during build -->
  <Import Project="$(SHFBROOT)\SandcastleHelpFileBuilder.targets" Condition="'$(MSBuildRestoreSessionId)' == ''" />
  <!-- The pre-build and post-build event properties must appear *after* the targets file import in order to be
			 evaluated correctly. -->
  <PropertyGroup>
    <PreBuildEvent>
    </PreBuildEvent>
    <PostBuildEvent>
    </PostBuildEvent>
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
  </PropertyGroup>
</Project>