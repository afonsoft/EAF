<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <RootNamespace>Eaf</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Eaf.Workflow</AssemblyName>
    <PackageId>Eaf.Workflow</PackageId>
    <PackageTags>asp.net;workflow;approval;enterprise application framework;Eaf</PackageTags>
    <Description>Enterprise Application Foundation - workflow and approval engine for ASP.NET Boilerplate</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Abp" Version="10.5.1" />
    <PackageReference Include="Abp.AutoMapper" Version="10.5.1" />
    <PackageReference Include="Abp.ZeroCore" Version="10.5.1" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Eaf.Workflow.Tests</_Parameter1>
    </AssemblyAttribute>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
