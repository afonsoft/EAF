<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\..\common.props" />

	<PropertyGroup>
		<RootNamespace>Eaf</RootNamespace>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<AssemblyName>Eaf.KeyVault</AssemblyName>
		<PackageId>Eaf.KeyVault</PackageId>
