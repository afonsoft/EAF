		<PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.13.0" />
		<PackageReference Include="OCI.DotNetSDK.Identity" Version="115.0.0" />
		<PackageReference Include="OCI.DotNetSDK.Secrets" Version="115.0.0" />
		<PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
		<PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.4.0" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.13.0" />
