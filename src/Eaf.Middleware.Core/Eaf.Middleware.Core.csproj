<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\common.props"></Import>
	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<AssemblyName>Eaf.Middleware.Core</AssemblyName>
